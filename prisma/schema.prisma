// WHARF data model — mirrors docs/spec-v2.md §3 (see docs/architecture.md §3 for notes).
// Models are PascalCase / fields camelCase; @@map/@map keep the SQL in snake_case.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Runtime connection — on Supabase use the pooled (pgbouncer) string, port 6543.
  url       = env("DATABASE_URL")
  // Migration/introspection connection — MUST be the direct string, port 5432
  // (pgbouncer cannot run migrations). Falls back unused if identical.
  directUrl = env("DIRECT_URL")
}

enum Role {
  admin
  operator
  viewer
}

enum AuthMethod {
  password
  private_key
}

enum InstanceStatus {
  provisioning
  running
  stopped
  error
  removing
  restoring
}

enum InstanceSslMode {
  require
  disable
}

model Server {
  id                 String     @id @default(uuid())
  name               String
  host               String
  sshPort            Int        @default(22) @map("ssh_port")
  sshUser            String     @map("ssh_user")
  authMethod         AuthMethod @map("auth_method")
  sshPasswordEnc     Bytes?     @map("ssh_password_enc")
  sshPrivateKeyEnc   Bytes?     @map("ssh_private_key_enc")
  linkedPanelUrl     String?    @map("linked_panel_url")
  panelUserEnc       Bytes?     @map("panel_user_enc")
  panelPassEnc       Bytes?     @map("panel_pass_enc")
  bootstrapped       Boolean    @default(false)
  reachable          Boolean    @default(true)
  hostKeyFingerprint String?    @map("host_key_fingerprint")
  // AES-256-GCM sealed JSON (lib/bootstrap/pooler-secrets.ts): the shared
  // per-server Supavisor pooler's own secrets (metadata DB password,
  // SECRET_KEY_BASE, VAULT_ENC_KEY, API_JWT_SECRET, METRICS_JWT_SECRET).
  // Generated once on first `installPooler` bootstrap step and reused on
  // every re-run so already-registered tenants never get orphaned by a
  // rotated VAULT_ENC_KEY. Null until the pooler has been bootstrapped.
  poolerSecretsEnc   Bytes?     @map("pooler_secrets_enc")
  poolerFirewallManaged Boolean @default(false) @map("pooler_firewall_managed")
  tags               String[]
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  websites    Website[]
  dbInstances DbInstance[]

  @@map("servers")
}

model Website {
  id                String   @id @default(uuid())
  domain            String
  serverId          String   @map("server_id")
  path              String
  dbInstanceId      String?  @map("db_instance_id")
  credentialLabel   String   @default("Admin login") @map("credential_label")
  accessUsername    String?  @map("access_username")
  accessPasswordEnc Bytes?   @map("access_password_enc")
  notes             String   @default("")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  server     Server      @relation(fields: [serverId], references: [id], onDelete: Restrict)
  dbInstance DbInstance? @relation(fields: [dbInstanceId], references: [id], onDelete: SetNull)

  @@map("websites")
}

model DbInstance {
  id                 String         @id @default(uuid())
  serverId           String         @map("server_id")
  name               String
  slug               String         @unique
  composeProjectName String         @map("compose_project_name")
  remotePath         String         @map("remote_path")
  apiSubdomain       String         @map("api_subdomain")
  studioSubdomain    String         @map("studio_subdomain")
  sslMode            InstanceSslMode @default(require) @map("ssl_mode")
  // Null is tolerated for legacy/directly-created rows and reads as Allow all;
  // the migration and provisioning pipeline store the explicit policy.
  networkAccess      Json?          @map("network_access")
  networkAccessAppliedAt DateTime?  @map("network_access_applied_at")
  networkAccessError String?        @map("network_access_error")
  pgPasswordEnc      Bytes?         @map("pg_password_enc")
  anonKeyEnc         Bytes?         @map("anon_key_enc")
  serviceRoleKeyEnc  Bytes?         @map("service_role_key_enc")
  jwtSecretEnc       Bytes?         @map("jwt_secret_enc")
  status             InstanceStatus @default(provisioning)
  lastActionLog      String?        @map("last_action_log")
  healthCheckedAt    DateTime?      @map("health_checked_at")
  deletedAt          DateTime?      @map("deleted_at")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  server            Server                     @relation(fields: [serverId], references: [id], onDelete: Restrict)
  websites          Website[]
  phoneDeliveries   PhoneDelivery[]
  authSettings      InstanceAuthSettings?
  emailTemplates    InstanceEmailTemplate[]
  analyticsSettings InstanceAnalyticsSettings?
  syncSource        InstanceSyncSource?

  @@unique([serverId, remotePath])
  @@map("db_instances")
}

/**
 * Self-hosted-configurable Auth (GoTrue) settings for one instance.
 * Kept as its own 1:1 model rather than more columns on DbInstance — matches
 * this schema's existing convention (Server/DbInstance both use discrete
 * `*Enc` columns, never a JSON secret blob) and gives this feature its own
 * migration/audit boundary. Applied to the instance by re-rendering its
 * .env/docker-compose.yml and restarting only its `auth` container
 * (lib/provision/auth-settings.ts) — never touched at provision time itself.
 */
model InstanceAuthSettings {
  id           String @id @default(uuid())
  dbInstanceId String @unique @map("db_instance_id")

  // Sign-up / session — mirrors templates/supabase/.env.template's Auth section.
  disableSignup          Boolean @default(false) @map("disable_signup")
  enableEmailSignup      Boolean @default(true) @map("enable_email_signup")
  enableEmailAutoconfirm Boolean @default(true) @map("enable_email_autoconfirm")
  enablePhoneSignup      Boolean @default(false) @map("enable_phone_signup")
  // GOTRUE_SMS_AUTOCONFIRM. Defaults true only because that is what
  // .env.template hardcoded before this was configurable — it confirms a
  // phone without sending or checking an OTP. Turning it off needs an SMS
  // provider, which this template does not render yet.
  enablePhoneAutoconfirm Boolean @default(true) @map("enable_phone_autoconfirm")
  enableAnonymousUsers   Boolean @default(false) @map("enable_anonymous_users")
  // GoTrue's linkIdentity/unlinkIdentity APIs — off in GoTrue's own default.
  manualLinkingEnabled   Boolean @default(false) @map("manual_linking_enabled")
  jwtExpirySeconds       Int     @default(3600) @map("jwt_expiry_seconds")
  additionalRedirectUrls String? @map("additional_redirect_urls")

  // Where the web app this instance backs actually lives. Null/empty on both
  // means "derive from the instance's own API origin" — exactly what
  // lib/provision/render.ts hardcoded before these existed.
  //
  // `siteUrl` is GoTrue's default post-auth landing URL (sign-in, recovery,
  // confirmation). `oauthCallbackUrl` is the address OAuth providers hand the
  // browser back to; it must resolve to THIS instance's GoTrue, so it only
  // ever differs from the derived value when a custom domain fronts the
  // instance and proxies /auth/v1/* through to it.
  siteUrl          String? @map("site_url")
  oauthCallbackUrl String? @map("oauth_callback_url")

  // SMTP — templates/supabase/.env.template ships a fake, non-resolving
  // relay by default (SMTP_HOST=supabase-mail); these let an operator point
  // at a real one.
  smtpHost       String? @map("smtp_host")
  smtpPort       Int?    @map("smtp_port")
  smtpUser       String? @map("smtp_user")
  smtpPassEnc    Bytes?  @map("smtp_pass_enc")
  smtpSenderName String? @map("smtp_sender_name")
  smtpAdminEmail String? @map("smtp_admin_email")

  // Both Twilio and MSG91 use the signed send-SMS hook. Supabase generates
  // and verifies codes; WHARF chooses delivery channel and handles fallback.
  smsProvider     String? @map("sms_provider")
  smsOtpExp       Int?    @map("sms_otp_exp")
  smsOtpLength    Int?    @map("sms_otp_length")
  smsMaxFrequency String? @map("sms_max_frequency")
  smsTemplate     String? @map("sms_template")

  smsTwilioAccountSid        String? @map("sms_twilio_account_sid")
  smsTwilioAuthTokenEnc      Bytes?  @map("sms_twilio_auth_token_enc")
  smsTwilioMessageServiceSid String? @map("sms_twilio_message_service_sid")
  smsTwilioDeliveryChannel String @default("sms") @map("sms_twilio_delivery_channel")
  smsTwilioWhatsappSender String? @map("sms_twilio_whatsapp_sender")
  smsTwilioContentSid String? @map("sms_twilio_content_sid")
  smsTwilioSmsFallback Boolean @default(false) @map("sms_twilio_sms_fallback")

  // MSG91's DLT-era fields: a flow/template id and the 6-character sender
  // header registered against it, plus the template variable the OTP is
  // substituted into (their templates name it themselves, so it varies).
  smsMsg91AuthKeyEnc  Bytes?  @map("sms_msg91_auth_key_enc")
  smsMsg91TemplateId  String? @map("sms_msg91_template_id")
  smsMsg91SenderId    String? @map("sms_msg91_sender_id")
  smsMsg91OtpVariable String? @map("sms_msg91_otp_variable")

  // OAuth providers — GOTRUE_EXTERNAL_* vars already exist (commented out)
  // in templates/supabase/docker-compose.yml.
  // `googleClientId` is a comma-separated list (GoTrue parses it into a
  // []string): the web OAuth client plus any native/One Tap client ids that
  // issue ID tokens for this project. `googleSkipNonceCheck` relaxes OIDC
  // replay protection for native SDKs that don't expose the nonce, and
  // `googleEmailOptional` admits a user the provider returns no email for.
  googleEnabled        Boolean @default(false) @map("google_enabled")
  googleClientId       String? @map("google_client_id")
  googleSecretEnc      Bytes?  @map("google_secret_enc")
  googleSkipNonceCheck Boolean @default(false) @map("google_skip_nonce_check")
  googleEmailOptional  Boolean @default(false) @map("google_email_optional")

  githubEnabled   Boolean @default(false) @map("github_enabled")
  githubClientId  String? @map("github_client_id")
  githubSecretEnc Bytes?  @map("github_secret_enc")

  azureEnabled   Boolean @default(false) @map("azure_enabled")
  azureClientId  String? @map("azure_client_id")
  azureSecretEnc Bytes?  @map("azure_secret_enc")

  // Apple's two fields mean something different from the others':
  // `appleClientId` is a Services ID (and GoTrue accepts a comma-separated
  // list, so a native bundle ID can ride along), and `appleSecretEnc` holds a
  // developer-generated ES256 JWT that Apple caps at 6 months — not a
  // long-lived secret like Google's. Stored identically regardless; the UI
  // carries the explanation.
  // `appleEmailOptional` earns its keep more than the others': Apple relays a
  // real address only on first consent, and "Hide My Email" substitutes a
  // private relay one.
  appleEnabled       Boolean @default(false) @map("apple_enabled")
  appleClientId      String? @map("apple_client_id")
  appleSecretEnc     Bytes?  @map("apple_secret_enc")
  appleEmailOptional Boolean @default(false) @map("apple_email_optional")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  dbInstance DbInstance @relation(fields: [dbInstanceId], references: [id], onDelete: Cascade)

  @@map("instance_auth_settings")
}

/**
 * The 6 GoTrue email flows a custom template/subject can be set for
 *. Values match GoTrue's own GOTRUE_MAILER_*_<FLOW> env var
 * suffixes uppercased (e.g. `magic_link` -> `MAGIC_LINK`).
 */
enum EmailTemplateFlow {
  confirmation
  recovery
  magic_link
  invite
  email_change
  reauthentication
}

/**
 * Per-instance, per-flow email customization. Separate from
 * InstanceAuthSettings because the shape is a list (one row per configured
 * flow), not a flat settings bag — a flow with no row means "use GoTrue's
 * own built-in default", not "explicitly reset to blank".
 * `bodyHtml` is never written into the instance's .env (GoTrue fetches it
 * over HTTP from GET /api/db-instances/:id/email-template/:flow — a public
 * route, see that route's doc comment) and so needs no newline restriction,
 * unlike every .env-bound string elsewhere in this schema. `subject` DOES
 * go into .env as GOTRUE_MAILER_SUBJECTS_<FLOW> and is restricted the same
 * way at the API boundary (lib/instances/auth-settings-schema.ts).
 */
model InstanceEmailTemplate {
  id           String            @id @default(uuid())
  dbInstanceId String            @map("db_instance_id")
  flow         EmailTemplateFlow
  subject      String?
  bodyHtml     String?           @map("body_html") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  dbInstance DbInstance @relation(fields: [dbInstanceId], references: [id], onDelete: Cascade)

  @@unique([dbInstanceId, flow])
  @@map("instance_email_templates")
}

/**
 * Storage Analytics buckets (Iceberg) per instance. Just a toggle —
 * `enabled` gates a Docker Compose `profiles: [analytics]` group (MinIO +
 * a Lakekeeper Iceberg REST catalog, both instance-local, no public route)
 * — off by default because, unlike Vector buckets, these are real extra
 * processes/RAM/disk per instance.
 * No secret columns here: MinIO's root password, the Iceberg catalog's
 * static bearer token, and Lakekeeper's own at-rest encryption key are all
 * derived from this instance's existing jwtSecret via HMAC, the same
 * pattern lib/provision/secrets.ts's `deriveAncillarySecrets` already uses
 * for the Storage S3-protocol keys and the Kong dashboard password — a
 * fresh independently-stored secret would provide no real extra rotation
 * ability (anyone with jwtSecret already holds the service_role key, i.e.
 * full API/DB access), so deriving keeps this model down to a pure toggle.
 * Lakekeeper runs in its own documented "Unsecured" mode (internal-network-
 * only trust boundary, same as this instance's own `db` Postgres port
 * today) rather than real OAuth, so the derived catalog token is a static
 * value Lakekeeper does not actually validate.
 */
model InstanceAnalyticsSettings {
  id           String  @id @default(uuid())
  dbInstanceId String  @unique @map("db_instance_id")
  enabled      Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  dbInstance DbInstance @relation(fields: [dbInstanceId], references: [id], onDelete: Cascade)

  @@map("instance_analytics_settings")
}

/**
 * Where a live-database sync pulls FROM.
 * `supabase` means a hosted Supabase project: the Postgres columns below are
 * still the ones that carry the dump (there is no dump API), `projectUrl` +
 * `serviceRoleKeyEnc` exist only so storage OBJECTS can be copied over the
 * Storage HTTP API. `postgres` is any other Postgres (Neon, RDS, another
 * WHARF instance) — storage copying is simply unavailable there.
 */
enum SyncSourceKind {
  supabase
  postgres
}

/**
 * Saved source for "sync from a live database" — the second source
 * for the restore engine, alongside an uploaded dump file.
 * 1:1 with the instance and stored (rather than used once and discarded) so a
 * migration can be re-run on demand without re-typing credentials; that is
 * the whole point of calling it a sync. Same discrete-`*Enc`-column
 * convention as InstanceAuthSettings — never a JSON secret blob.
 * The credentials here grant full READ of the source project, so every route
 * that touches this row is admin-only (`instance.restore` in lib/rbac.ts) and
 * neither secret is ever echoed back on a read — only a `*Configured`
 * boolean, the same rule as InstanceSecretsDto.
 * `pgHost`/`pgUser`/`pgDatabase`/`pgSslMode` are re-validated against a
 * conservative charset at the API boundary (lib/instances/sync-source-schema.ts)
 * because they are interpolated into a connection string that reaches a remote
 * shell — shell-quoting in lib/provision/sync.ts is the second layer, not the
 * only one.
 */
model InstanceSyncSource {
  id           String         @id @default(uuid())
  dbInstanceId String         @unique @map("db_instance_id")
  kind         SyncSourceKind @default(supabase)
  label        String?

  // Postgres connection — used for every dump pass regardless of `kind`.
  pgHost        String @map("pg_host")
  pgPort        Int    @default(5432) @map("pg_port")
  pgDatabase    String @default("postgres") @map("pg_database")
  pgUser        String @map("pg_user")
  pgPasswordEnc Bytes  @map("pg_password_enc")
  pgSslMode     String @default("require") @map("pg_ssl_mode")

  // Supabase-only extras — required to copy storage objects, unused otherwise.
  projectUrl        String? @map("project_url")
  serviceRoleKeyEnc Bytes?  @map("service_role_key_enc")

  // What a sync copies. The main pass (schema + data) always runs; these two
  // are data-only passes over tables the target already owns the schema of.
  includeAuthUsers      Boolean  @default(true) @map("include_auth_users")
  includeStorageObjects Boolean  @default(false) @map("include_storage_objects")
  extraSchemas          String[] @map("extra_schemas")

  // Last outcome, shown in the modal so a re-sync has context.
  lastSyncedAt    DateTime? @map("last_synced_at")
  lastSyncStatus  String?   @map("last_sync_status")
  lastSyncSummary String?   @map("last_sync_summary")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  dbInstance DbInstance @relation(fields: [dbInstanceId], references: [id], onDelete: Cascade)

  @@map("instance_sync_sources")
}

model PanelUser {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(viewer)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("panel_users")
}

// Insert-only (enforced by a Postgres trigger, migration 20260724000002_audit_immutable).
model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  userEmail  String?  @map("user_email")
  action     String
  targetType String   @map("target_type")
  targetId   String?  @map("target_id")
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([createdAt(sort: Desc)])
  @@index([action])
  @@map("audit_log")
}

// Short-lived delivery state, never an authentication/verification store.
model PhoneDelivery {
  id String @id
  dbInstanceId String @map("db_instance_id")
  recipientHash String @map("recipient_hash")
  requestHash String @map("request_hash")
  channel String
  fallbackEnabled Boolean @map("fallback_enabled")
  state String
  primarySid String? @map("primary_sid")
  fallbackSid String? @map("fallback_sid")
  // Encrypted code, recipient, sender configuration and callback credential snapshot.
  payloadEnc Bytes? @map("payload_enc")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  instance DbInstance @relation(fields: [dbInstanceId], references: [id], onDelete: Cascade)
  @@index([dbInstanceId, recipientHash])
  @@index([expiresAt])
  @@index([createdAt])
  @@map("phone_deliveries")
}
