############
# WHARF per-instance Supabase environment (/ ).
#
# Derived from supabase/supabase @ 9cf6ae1f6779efcef70dcc94d64e5d8e1cee8304
# docker/.env.example, trimmed to the services WHARF ships (see VERSIONS.md).
#
# Every double-brace placeholder below is substituted by lib/provision/render.ts.
# Rendering THROWS if any placeholder survives, so this file can never reach a
# server with a literal placeholder in it (that guard also means this comment
# block must not contain an example one). Values land unquoted in a .env read by
# `docker compose --env-file`, so generated secrets are restricted to
# [A-Za-z0-9] (see lib/provision/secrets.ts) -- no quoting required.
#
# Do not commit a rendered copy of this file: it holds live credentials.
############


############
# Secrets - generated per instance, never shared between instances
############

# Postgres superuser password. 32 chars, [A-Za-z0-9] only, so it is safe
# unquoted here and inside postgres:// DSNs.
POSTGRES_PASSWORD={{POSTGRES_PASSWORD}}

# Legacy symmetric HS256 key (40 random bytes, hex) used to sign and verify
# the anon / service_role API keys below.
JWT_SECRET={{JWT_SECRET}}

# Legacy API keys (HS256-signed JWTs, role claims anon / service_role).
ANON_KEY={{ANON_KEY}}
SERVICE_ROLE_KEY={{SERVICE_ROLE_KEY}}

# Asymmetric (ES256) / opaque API keys. WHARF does not issue these yet; Kong
# and the entrypoint script fall back to legacy-key behaviour when empty.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
JWT_KEYS=
JWT_JWKS=
ANON_KEY_ASYMMETRIC=
SERVICE_ROLE_KEY_ASYMMETRIC=

# Kong basic-auth credentials for the /dashboard route it proxies. Studio
# itself is additionally gated by Traefik's wharf-auth forwardAuth middleware
# (architecture.md 4.3), so this is defence in depth, not the primary gate.
DASHBOARD_USERNAME={{DASHBOARD_USERNAME}}
DASHBOARD_PASSWORD={{DASHBOARD_PASSWORD}}

# Realtime Phoenix signing salt (>= 64 chars).
SECRET_KEY_BASE={{SECRET_KEY_BASE}}

# Realtime encryption key for the _realtime schema (exactly 16 chars).
REALTIME_DB_ENC_KEY={{REALTIME_DB_ENC_KEY}}

# Studio <-> postgres-meta connection-string encryption key (>= 32 chars).
PG_META_CRYPTO_KEY={{PG_META_CRYPTO_KEY}}

# Storage S3-protocol endpoint credentials.
S3_PROTOCOL_ACCESS_KEY_ID={{S3_PROTOCOL_ACCESS_KEY_ID}}
S3_PROTOCOL_ACCESS_KEY_SECRET={{S3_PROTOCOL_ACCESS_KEY_SECRET}}


############
# URLs - all HTTPS, terminated by the WHARF-managed Traefik
############

# Public API origin: https://{slug}.{INSTANCE_DOMAIN}
SUPABASE_PUBLIC_URL={{SUPABASE_PUBLIC_URL}}

# Auth's external base URL, used for OAuth callbacks and email links.
API_EXTERNAL_URL={{API_EXTERNAL_URL}}


############
# Database
############

POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432


############
# Studio
############

STUDIO_DEFAULT_ORGANIZATION={{STUDIO_DEFAULT_ORGANIZATION}}
STUDIO_DEFAULT_PROJECT={{STUDIO_DEFAULT_PROJECT}}

# Optional: set to enable Studio's AI assistant.
OPENAI_API_KEY=


############
# Auth
############

## SITE_URL is where GoTrue sends a user after sign-in, recovery and email
## confirmation — the web app this instance backs, not the instance itself.
## Defaults to the instance's own API origin until an operator sets one.
SITE_URL={{SITE_URL}}
ADDITIONAL_REDIRECT_URLS={{ADDITIONAL_REDIRECT_URLS}}

JWT_EXPIRY={{JWT_EXPIRY}}
DISABLE_SIGNUP={{DISABLE_SIGNUP}}

## Mailer
MAILER_URLPATHS_CONFIRMATION="/auth/v1/verify"
MAILER_URLPATHS_INVITE="/auth/v1/verify"
MAILER_URLPATHS_RECOVERY="/auth/v1/verify"
MAILER_URLPATHS_EMAIL_CHANGE="/auth/v1/verify"

## Email templates — admin-configurable via the panel's instance
## Email templates tab. MAILER_SUBJECTS_* are plain strings; MAILER_TEMPLATES_*
## must be a URL GoTrue fetches via GET at container startup (confirmed:
## GoTrue caches the result, and treats an empty value exactly like the var
## being unset — falls back to its own built-in default template). Empty
## here until an operator configures a flow, so this is a no-op by default.
MAILER_SUBJECTS_CONFIRMATION={{MAILER_SUBJECTS_CONFIRMATION}}
MAILER_TEMPLATES_CONFIRMATION={{MAILER_TEMPLATES_CONFIRMATION}}
MAILER_SUBJECTS_RECOVERY={{MAILER_SUBJECTS_RECOVERY}}
MAILER_TEMPLATES_RECOVERY={{MAILER_TEMPLATES_RECOVERY}}
MAILER_SUBJECTS_MAGIC_LINK={{MAILER_SUBJECTS_MAGIC_LINK}}
MAILER_TEMPLATES_MAGIC_LINK={{MAILER_TEMPLATES_MAGIC_LINK}}
MAILER_SUBJECTS_INVITE={{MAILER_SUBJECTS_INVITE}}
MAILER_TEMPLATES_INVITE={{MAILER_TEMPLATES_INVITE}}
MAILER_SUBJECTS_EMAIL_CHANGE={{MAILER_SUBJECTS_EMAIL_CHANGE}}
MAILER_TEMPLATES_EMAIL_CHANGE={{MAILER_TEMPLATES_EMAIL_CHANGE}}
MAILER_SUBJECTS_REAUTHENTICATION={{MAILER_SUBJECTS_REAUTHENTICATION}}
MAILER_TEMPLATES_REAUTHENTICATION={{MAILER_TEMPLATES_REAUTHENTICATION}}

## Email auth. Defaults: no real SMTP relay, so autoconfirm is ON —
## without it every signup would hang waiting for a mail that is never
## delivered. Admin-configurable via the panel's instance Auth settings
## (lib/provision/auth-settings.ts); until set, these render as the same
## fake/non-resolving relay + autoconfirm-on defaults this file always had.
ENABLE_EMAIL_SIGNUP={{ENABLE_EMAIL_SIGNUP}}
ENABLE_EMAIL_AUTOCONFIRM={{ENABLE_EMAIL_AUTOCONFIRM}}
SMTP_ADMIN_EMAIL={{SMTP_ADMIN_EMAIL}}
SMTP_HOST={{SMTP_HOST}}
SMTP_PORT={{SMTP_PORT}}
SMTP_USER={{SMTP_USER}}
SMTP_PASS={{SMTP_PASS}}
SMTP_SENDER_NAME={{SMTP_SENDER_NAME}}
ENABLE_ANONYMOUS_USERS={{ENABLE_ANONYMOUS_USERS}}

## Phone auth
ENABLE_PHONE_SIGNUP={{ENABLE_PHONE_SIGNUP}}
ENABLE_PHONE_AUTOCONFIRM=true

## The one address every provider redirects back to, shared by all four below.
## Always this instance's own GoTrue — https://<api-subdomain>/auth/v1/callback
## unless a custom domain fronts the instance and proxies /auth/v1/* to it.
OAUTH_CALLBACK_URL={{OAUTH_CALLBACK_URL}}

## OAuth providers — admin-configurable via the panel's instance
## Auth settings. GOOGLE_ENABLED/GITHUB_ENABLED/AZURE_ENABLED/APPLE_ENABLED
## default to "false" (provider disabled) until an operator sets real
## credentials; docker-compose.yml's auth service only reads these when the
## corresponding GOTRUE_EXTERNAL_*_ENABLED var is uncommented (it is, as of
## ).
## GOOGLE_CLIENT_ID accepts a comma-separated list — the web OAuth client plus
## any Android/iOS/One Tap/Chrome-extension client ids that issue ID tokens for
## this project. SKIP_NONCE_CHECK relaxes OIDC replay protection (needed by some
## native SDKs that don't expose the nonce); EMAIL_OPTIONAL lets a user through
## when the provider returns no email address. Both default to "false".
GOOGLE_ENABLED={{GOOGLE_ENABLED}}
GOOGLE_CLIENT_ID={{GOOGLE_CLIENT_ID}}
GOOGLE_SECRET={{GOOGLE_SECRET}}
GOOGLE_SKIP_NONCE_CHECK={{GOOGLE_SKIP_NONCE_CHECK}}
GOOGLE_EMAIL_OPTIONAL={{GOOGLE_EMAIL_OPTIONAL}}
GITHUB_ENABLED={{GITHUB_ENABLED}}
GITHUB_CLIENT_ID={{GITHUB_CLIENT_ID}}
GITHUB_SECRET={{GITHUB_SECRET}}
AZURE_ENABLED={{AZURE_ENABLED}}
AZURE_CLIENT_ID={{AZURE_CLIENT_ID}}
AZURE_SECRET={{AZURE_SECRET}}
## Apple: CLIENT_ID is a Services ID (GoTrue accepts a comma-separated list, so
## a native app's bundle ID can ride along), and SECRET is a developer-generated
## ES256 JWT that Apple caps at 6 months — it expires and must be regenerated,
## unlike the other providers' long-lived secrets.
## Apple relays a real address only on first consent (and "Hide My Email" gives
## a private relay one), so EMAIL_OPTIONAL matters more here than elsewhere.
APPLE_ENABLED={{APPLE_ENABLED}}
APPLE_CLIENT_ID={{APPLE_CLIENT_ID}}
APPLE_SECRET={{APPLE_SECRET}}
APPLE_EMAIL_OPTIONAL={{APPLE_EMAIL_OPTIONAL}}


############
# Storage
############

GLOBAL_S3_BUCKET=stub
REGION=stub
STORAGE_TENANT_ID=stub

## Vector buckets — self-hostable via the pgvector backend, no new
## container: storage-api itself runs CREATE DATABASE against a maintenance
## connection (this IS the postgres superuser, not supabase_storage_admin —
## it needs CREATEDB) and derives its own `storage_vectors` database from it.
## Always on: this is genuinely free (reuses the same Postgres container),
## unlike Analytics buckets below, so there's no per-instance toggle.
VECTOR_ENABLED=true
VECTOR_BUCKET_PROVIDER=pgvector
VECTOR_DATABASE_URL=postgres://postgres:{{POSTGRES_PASSWORD}}@db:5432/postgres
VECTOR_DATABASE_CREATE=true
VECTOR_STORE_MIGRATIONS_ENABLED=true

## Analytics buckets (Iceberg, ) — opt-in per instance, off by default:
## unlike Vector buckets above, MinIO + Lakekeeper are real extra containers,
## so COMPOSE_PROFILES only includes "analytics" once an operator enables it
## (see lib/provision/analytics-settings.ts). storage-api is a standard
## Apache Iceberg REST Catalog *client*; Lakekeeper runs in its own
## documented "Unsecured" mode (no OIDC config at all — confirmed against
## Lakekeeper's own minimal example) since it's never reachable outside this
## instance's own Docker network, so ICEBERG_CATALOG_AUTH_TOKEN is a static
## value Lakekeeper doesn't actually validate.
ICEBERG_ENABLED={{ICEBERG_ENABLED}}
ICEBERG_CATALOG_URL=http://lakekeeper:8181/catalog
ICEBERG_WAREHOUSE=default
ICEBERG_CATALOG_AUTH_TYPE=token
ICEBERG_CATALOG_AUTH_TOKEN={{ICEBERG_CATALOG_AUTH_TOKEN}}

# Which Docker Compose profiles are active for this instance's own compose
# project — "analytics" starts minio/minio-init/lakekeeper/lakekeeper-init
# (all `profiles: ["analytics"]`), otherwise they're defined but never run.
COMPOSE_PROFILES={{COMPOSE_PROFILES}}

MINIO_ROOT_USER={{MINIO_ROOT_USER}}
MINIO_ROOT_PASSWORD={{MINIO_ROOT_PASSWORD}}
LAKEKEEPER_PG_ENCRYPTION_KEY={{LAKEKEEPER_PG_ENCRYPTION_KEY}}


############
# API - PostgREST
############

PGRST_DB_SCHEMAS=public,graphql_public
PGRST_DB_MAX_ROWS=1000
## `extensions` is required, not optional. PostgREST builds its own
## per-request search_path from PGRST_DB_SCHEMAS + this, overriding the
## database default (which supabase/postgres already sets to
## "$user", public, extensions). Operators are resolved ONLY through
## search_path — they cannot be schema-qualified by name the way a type or
## function can — so without `extensions` here every RPC using a bare
## operator from an extension fails with, e.g.:
##   operator does not exist: extensions.vector <=> extensions.vector
## That breaks any pgvector similarity search reached through the API, even
## though the same query works over a direct/pooler connection. Hosted
## Supabase has extensions on the path, so a project synced in from there
## brings functions written against that assumption.
PGRST_DB_EXTRA_SEARCH_PATH=public,extensions


############
# API gateway - Kong
#
# These are NOT published on the host: render.ts strips kong's `ports:` so
# instances cannot collide on host ports. Traefik reaches kong over the shared
# `traefik` network on container port 8000. The vars remain because the
# vendored compose still interpolates them.
############

KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443


############
# imgproxy
############

IMGPROXY_AUTO_WEBP=true
