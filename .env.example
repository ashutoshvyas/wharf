# ============================================================
# WHARF environment. Copy to .env and fill in.
#
# Deployment model: the panel + gateway run directly on a VPS
# (node processes, no Docker). The panel metadata DB lives on
# your own Supabase server's Postgres.
# ============================================================

# ---- Panel metadata database (your Supabase Postgres) ----
# DATABASE_URL  = runtime connection. On Supabase use the POOLED string
#                 (pgbouncer, port 6543) and keep pgbouncer=true:
#   postgresql://postgres.<ref>:<PASSWORD>@<host>:6543/postgres?pgbouncer=true&sslmode=require
#                 Self-hosted Supabase without a pooler: use the direct
#                 string here too (port 5432).
# DIRECT_URL    = direct connection (port 5432) — required for
#                 `prisma migrate`; pgbouncer cannot run migrations:
#   postgresql://postgres:<PASSWORD>@<host>:5432/postgres?sslmode=require
DATABASE_URL=""
DIRECT_URL=""

# ---- Auth ----
# Session signing secret. Generate: openssl rand -base64 32
NEXTAUTH_SECRET=""

# Public URL of the panel (auth callbacks + forwardAuth redirects).
NEXTAUTH_URL="http://localhost:3000"
PANEL_URL="http://localhost:3000"

# Cookie domain for the session cookie. MUST be the apex domain shared with
# instance subdomains in production (e.g. ".wharf.example.com") so Traefik forwardAuth
# on studio-*.domain can see the panel session (architecture §4.5).
# Leave empty for localhost development.
COOKIE_DOMAIN=""

# ---- Secrets encryption ----
# Master key for every *_enc column (AES-256-GCM). MUST decode to exactly
# 32 bytes. Generate: openssl rand -base64 32
# Store a copy OUTSIDE the VPS — the DB backup is useless without it.
WHARF_MASTER_KEY=""

# ---- Ports (pm2 / systemd bind these; the reverse proxy points at them) ----
# Panel listens on PANEL_PORT (default 3000), gateway on GATEWAY_PORT (3001).
PANEL_PORT="3000"

# ---- Terminal Gateway ----
GATEWAY_PORT="3001"

# ---- First admin (created by `npm run db:seed`) ----
ADMIN_EMAIL="admin@example.com"
# Choose a unique passphrase of at least 12 characters; required by db:seed.
ADMIN_PASSWORD=""

# Set to 1 to also seed demo fixtures (dev only).
SEED_DEMO="0"

# WebSocket URL of the Terminal Gateway as seen from the BROWSER.
# Dev: ws://localhost:3001 · Prod: wss://panel.<domain> (proxied /ws/* path)
NEXT_PUBLIC_GATEWAY_WS_URL="ws://localhost:3001"

# Same value, read server-side when building the CSP. NEXT_PUBLIC_* variables
# are frozen into the bundle at build time; this one is read at runtime, so
# changing the gateway URL needs only a restart. Keep the two in sync.
GATEWAY_WS_URL="ws://localhost:3001"

# Email for Let's Encrypt registration (Traefik cert resolver on managed servers).
LETSENCRYPT_EMAIL="admin@example.com"

# Apex domain instance subdomains are created under: {slug}.<domain> and
# studio-{slug}.<domain>. Requires a wildcard A record *.<domain> → database
# server IP (spec §2). Must share the apex with COOKIE_DOMAIN for Studio SSO.
INSTANCE_DOMAIN="wharf.example.com"

# How often (ms) the panel compares each instance's status with the containers
# actually running on its server (one read-only `docker ps` over SSH per server
# per pass). Default 60000; minimum 15000; 0 disables the check.
# HEALTH_CHECK_INTERVAL_MS="60000"
